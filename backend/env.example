# Copy this file to `.env` (same folder) and fill in your key. `.env` is gitignored.

# Required for transcribing Instagram reels.
# Free key, no card needed: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: pin the spoken language if auto-detect guesses wrong
# (ISO-639-1 code, e.g. hi, en). Leave empty to auto-detect.
GROQ_LANGUAGE=

# Optional: whisper-large-v3 (default, most accurate) or whisper-large-v3-turbo (faster).
GROQ_WHISPER_MODEL=whisper-large-v3
